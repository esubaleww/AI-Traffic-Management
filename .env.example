# Mock data — set to "false" to use the real backend
VITE_USE_MOCK=true

# REST API base URL (no trailing slash)
VITE_API_URL=http://localhost:8000

# WebSocket URL for the live traffic stream
VITE_WS_URL=ws://localhost:8000/ws

# Feature flags (default false / unset = hidden)
VITE_ENABLE_REPORT=false
VITE_ENABLE_SPEED=false
VITE_ENABLE_PLATES=false
